<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="Zanjan.net.xml"/>
        <route-files value="routes.rou.xml"/>
        <!-- <additional-files value="Zanjan.poly.xml"/> -->
    </input>
    <time>
        <begin value="0"/>
        <end value="300"/>
        <!-- must match (or divide) *.manager.updateInterval in omnetpp.ini -->
        <step-length value="1"/>
    </time>
</configuration>
