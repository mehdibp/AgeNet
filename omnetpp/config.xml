<?xml version="1.0" encoding="UTF-8"?>
<root>
    <!-- How the signal weakens: free-space path loss at 5.89 GHz (802.11p, CCH 178). -->
    <!-- Buildings (SimpleObstacleShadowing) are intentionally NOT enabled yet. -->
    <AnalogueModels>
        <AnalogueModel type="SimplePathlossModel">
            <parameter name="alpha" type="double" value="2.0"/>
            <parameter name="carrierFrequency" type="double" value="5.890e+9"/>
        </AnalogueModel>
    </AnalogueModels>

    <!-- How a receiver decides if a frame was received correctly (SNR/BER based). -->
    <Decider type="Decider80211p">
        <parameter name="centerFrequency" type="double" value="5.890e9"/>
    </Decider>
</root>
