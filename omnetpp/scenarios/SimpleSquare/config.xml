<?xml version="1.0" encoding="UTF-8"?>

<root>
    <!-- Radio propagation models -->
    <AnalogueModels>

        <!-- Free-space path-loss approximation -->
        <AnalogueModel type="SimplePathlossModel">
            <parameter name="alpha" type="double" value="2.0"/>
        </AnalogueModel>

        <!-- Building-induced signal attenuation -->
        <AnalogueModel type="SimpleObstacleShadowing" thresholding="true">
            <obstacles>
                <type id="building" db-per-cut="9" db-per-meter="0.4"/>
            </obstacles>
        </AnalogueModel>

    </AnalogueModels>

    <!-- Frame reception decision model -->
    <Decider type="Decider80211p">
        <parameter name="centerFrequency" type="double" value="5.890e9"/>
    </Decider>
</root>
